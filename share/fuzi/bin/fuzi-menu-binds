#!/usr/bin/env bash

# Repeating the keybind closes the active menu instead of opening a second
# selector process that waits forever for its own completion file.
if [[ $(fuzi-shell shell isOpen fuzi.menu 2>/dev/null || true) == "true" ]]; then
  fuzi-shell shell hide fuzi.menu >/dev/null
  exit 0
fi

# Resolve XKB keycodes for code: bindings to symbols via compiled keymap
parse_keycodes() {
  awk '
    BEGIN {
      split("10=1 11=2 12=3 13=4 14=5 15=6 16=7 17=8 18=9 19=0 20=MINUS 21=EQUAL 59=COMMA 60=PERIOD 61=SLASH", fallbacks, " ")
      for (i in fallbacks) {
        separator = index(fallbacks[i], "=")
        keycode_symbol[substr(fallbacks[i], 1, separator - 1)] = substr(fallbacks[i], separator + 1)
      }

      keymap_cmd = "xkbcli compile-keymap </dev/null 2>/dev/null"
      section = ""
      while ((keymap_cmd | getline line) > 0) {
        if (line ~ /xkb_keycodes/) { section = "codes"; continue }
        if (line ~ /xkb_symbols/)  { section = "syms";  continue }
        if (section == "codes" && match(line, /<([A-Za-z0-9_]+)>\s*=\s*([0-9]+)\s*;/, m)) code_by_name[m[1]] = m[2]
        if (section == "syms" && match(line, /key\s*<([A-Za-z0-9_]+)>\s*\{\s*\[\s*([^, \]]+)/, m)) sym_by_name[m[1]] = m[2]
      }
      close(keymap_cmd)

      for (name in code_by_name) {
        code = code_by_name[name]
        symbol = sym_by_name[name]
        if (code != "" && symbol != "" && symbol != "NoSymbol") keycode_symbol[code] = toupper(symbol)
      }

      mouse_symbol["272"] = "LEFT MOUSE BUTTON"
      mouse_symbol["273"] = "RIGHT MOUSE BUTTON"
      mouse_symbol["274"] = "MIDDLE MOUSE BUTTON"
    }
    {
      if (match($0, /code:([0-9]+)/, match_parts)) {
        code = match_parts[1]
        symbol = keycode_symbol[code]
        if (symbol == "") symbol = "code:" code
        sub("code:" code, symbol)
      } else if (match($0, /mouse:([0-9]+)/, match_parts)) {
        code = match_parts[1]
        symbol = mouse_symbol[code]
        if (symbol == "") symbol = "mouse:" code
        sub("mouse:" code, symbol)
      }

      print
    }
  '
}

find_mango_configs() {
  local base_dir="${XDG_CONFIG_HOME:-$HOME/.config}/mango"
  local files=()

  [[ -f "$base_dir/config.conf" ]] && files+=("$base_dir/config.conf")
  [[ -f "$base_dir/config.toml" ]] && files+=("$base_dir/config.toml")

  if [[ ${#files[@]} -eq 0 && -d "$base_dir" ]]; then
    while IFS= read -r f; do
      [[ -n $f ]] && files+=("$f")
    done < <(find "$base_dir" -maxdepth 2 -type f \( -name "*.conf" -o -name "*.toml" \) 2>/dev/null)
  fi

  local checked=()
  local to_check=("${files[@]}")
  while [[ ${#to_check[@]} -gt 0 ]]; do
    local current="${to_check[0]}"
    to_check=("${to_check[@]:1}")
    [[ -z "$current" || " ${checked[*]} " == *" $current "* ]] && continue
    checked+=("$current")

    if [[ -f "$current" ]]; then
      while IFS= read -r line; do
        if [[ $line =~ ^[[:space:]]*source(-optional)?[[:space:]]*=[[:space:]]*(.+) ]]; then
          local src="${BASH_REMATCH[2]}"
          src="${src#[\"\']}"
          src="${src%[\"\']}"
          src="${src/#\~/$HOME}"
          if [[ $src != /* ]]; then
            src="$(dirname "$current")/$src"
          fi
          if [[ -f "$src" && " ${checked[*]} " != *" $src "* ]]; then
            to_check+=("$src")
            files+=("$src")
          fi
        fi
      done < "$current"
    fi
  done

  printf '%s\n' "${files[@]}" | sort -u
}

dynamic_bindings() {
  local configs
  configs=$(find_mango_configs)
  [[ -z $configs ]] && return 0

  while IFS= read -r conf_file; do
    [[ -f "$conf_file" ]] || continue
    awk '
      function trim(s) {
        sub(/^[ \t\r\n]+/, "", s)
        sub(/[ \t\r\n]+$/, "", s)
        return s
      }

      function unquote(s) {
        s = trim(s)
        gsub(/^["\x27]|["\x27]$/, "", s)
        return trim(s)
      }

      function friendly_desc(cmd, arg) {
        if (cmd == "killclient") return "Close window"
        if (cmd == "reload_config") return "Reload config"
        if (cmd == "quit") return "Exit Mango"
        if (cmd == "toggleoverview") return "Toggle overview"
        if (cmd == "togglefloating") return "Toggle window floating"
        if (cmd == "view") return "Focus workspace " arg
        if (cmd == "tag") return "Move window to workspace " arg
        if (cmd == "tagmon") return "Move window to monitor " arg
        if (cmd == "focusmon") return "Focus monitor " arg
        if (cmd == "focusstack") return "Cycle focus " arg
        if (cmd == "resizewin") return "Resize window " arg
        if (cmd == "setkeymode") return "Switch key mode " arg
        if (cmd == "spawn" || cmd == "exec") {
          c = arg
          sub(/^[ \t]+|[ \t]+$/, "", c)
          return c
        }
        if (arg != "") return cmd " " arg
        return cmd
      }

      {
        line = $0
        desc = ""

        comment_idx = index(line, "#")
        if (comment_idx > 0) {
          desc = trim(substr(line, comment_idx + 1))
          line = substr(line, 1, comment_idx - 1)
        }

        line = trim(line)
        if (line == "") next

        bind_str = ""
        if (match(line, /bind[a-z]*[ \t]*=[ \t]*(.*)/, m)) {
          bind_str = m[1]
        } else if (match(line, /^["\x27]([A-Za-z0-9_+]+,[^"\x27]+)["\x27]/, m)) {
          bind_str = m[1]
        } else {
          next
        }

        bind_str = unquote(bind_str)
        sub(/[,\[\]]+$/, "", bind_str)
        bind_str = unquote(bind_str)

        n = split(bind_str, parts, ",")
        if (n < 3) next

        mods = trim(parts[1])
        key = trim(parts[2])
        cmd = trim(parts[3])

        arg = ""
        for (i = 4; i <= n; i++) {
          arg = (arg == "" ? parts[i] : arg "," parts[i])
        }
        arg = trim(arg)

        if (mods == "NONE" || mods == "none") mods = ""
        gsub(/\+/, " ", mods)

        if (desc == "") {
          desc = friendly_desc(cmd, arg)
        }

        printf "%s,%s,%s,%s,%s\n", mods, key, desc, cmd, arg
      }
    ' "$conf_file"
  done <<< "$configs"
}

static_bindings() {
  echo "SUPER SHIFT,#,Move workspace,tag,#"
  echo "SUPER,#,Focus workspace,view,#"
}

parse_binding_records() {
  awk -F, '
{
    key_combo = $1 " + " $2;
    gsub(/^[ \t]*\+?[ \t]*/, "", key_combo);
    gsub(/[ \t]+$/, "", key_combo);

    action = $3;
    dispatcher = $4;

    arg = "";
    for (i = 5; i <= NF; i++) {
        arg = arg $i (i < NF ? "," : "");
    }

    if (action == "") {
        for (i = 4; i <= NF; i++) {
            action = action $i (i < NF ? "," : "");
        }

        sub(/,$/, "", action);
        gsub(/(^|,)[[:space:]]*(exec|spawn)[[:space:]]*,?/, "", action);
        gsub(/(^|[[:space:]])uwsm(-app| app)[[:space:]]+--[[:space:]]+/, "", action);
        gsub(/^[ \t]+|[ \t]+$/, "", action);
        gsub(/[ \t]+/, " ", key_combo);
    }

    if (action != "") {
        printf "%-35s → %s\t%s\t%s\n", key_combo, action, dispatcher, arg;
    }
}'
}

prioritize_entries() {
  awk -F '\t' '
  {
    line = $1
    prio = 50
    if (match(line, /Terminal/)) prio = 0
    if (match(line, /Tmux/)) prio = 1
    if (match(line, /Browser/) && !match(line, /Browser[[:space:]]*\(/) && !match(line, /SUPER SHIFT.*\+.*B.*→.*Browser/)) prio = 2
    if (match(line, /File manager/) && !match(line, /File manager \(cwd\)/)) prio = 3
    if (match(line, /Launch apps/)) prio = 4
    if (match(line, /fuzi menu/)) prio = 5
    if (match(line, /System menu/)) prio = 6
    if (match(line, /Theme menu/)) prio = 7
    if (match(line, /Full screen/)) prio = 8
    if (match(line, /Full width/)) prio = 9
    if (match(line, /Close window/)) prio = 10
    if (match(line, /Close all windows/)) prio = 11
    if (match(line, /Lock system/)) prio = 12
    if (match(line, /Toggle window floating/)) prio = 13
    if (match(line, /Toggle window split/)) prio = 14
    if (match(line, /Pop window/)) prio = 15
    if (match(line, /Universal/)) prio = 16
    if (match(line, /Clipboard/)) prio = 17
    if (match(line, /Audio controls/)) prio = 18
    if (match(line, /Bluetooth controls/)) prio = 19
    if (match(line, /Wifi controls/)) prio = 20
    if (match(line, /Emojis/)) prio = 21
    if (match(line, /Color picker/)) prio = 22
    if (match(line, /Screenshot/)) prio = 23
    if (match(line, /Screenrecording/)) prio = 24
    if (match(line, /SUPER SHIFT.*\+.*B.*→.*Browser/)) prio = 25
    if (match(line, /File manager \(cwd\)/)) prio = 26
    if (match(line, /(Switch|Next|Former|Previous).*workspace/)) prio = 27
    if (match(line, /Move window to workspace/)) prio = 28
    if (match(line, /Move window silently to workspace/)) prio = 29
    if (match(line, /Swap window/)) prio = 30
    if (match(line, /Focus/)) prio = 31
    if (match(line, /Move window$/)) prio = 32
    if (match(line, /Resize window/)) prio = 33
    if (match(line, /Expand window/)) prio = 34
    if (match(line, /Shrink window/)) prio = 35
    if (match(line, /scratchpad/)) prio = 36
    if (match(line, /notification/)) prio = 37
    if (match(line, /Toggle window transparency/)) prio = 38
    if (match(line, /Toggle workspace gaps/)) prio = 39
    if (match(line, /Toggle nightlight/)) prio = 40
    if (match(line, /Toggle locking/)) prio = 41
    if (match(line, /group/)) prio = 94
    if (match(line, /Scroll active workspace/)) prio = 95
    if (match(line, /Cycle to/)) prio = 96
    if (match(line, /Reveal active/)) prio = 97
    if (match(line, /Apple Display/)) prio = 98
    if (match(line, /XF86/)) prio = 99
    if (match(line, /Show Tmux key ?bindings/)) prio = 100

    printf "%d\t%s\n", prio, $0
  }' |
    sort -k1,1n -k2,2 |
    cut -f2-
}

output_binding_records_uncached() {
  local dynamic

  dynamic=$(dynamic_bindings)

  {
    [[ -n $dynamic ]] && printf '%s\n' "$dynamic"
    static_bindings
  } |
    sort -u |
    parse_keycodes |
    parse_binding_records |
    prioritize_entries

  [[ -n $dynamic ]]
}

keybindings_cache_key() {
  {
    printf 'mango-v1\n'
    for f in $(find_mango_configs); do
      [[ -f "$f" ]] && cat "$f"
    done
  } | sha256sum | awk '{ print $1 }'
}

refresh_keybindings_cache() {
  local cache_dir="$1"
  local cache_file="$2"
  local cache_name="$3"
  local tmp_file

  tmp_file=$(mktemp "$cache_dir/keybindings.XXXXXX") || return 1

  if output_binding_records_uncached >"$tmp_file"; then
    mv "$tmp_file" "$cache_file"
    find "$cache_dir" -maxdepth 1 -type f -name 'keybindings-*.records' ! -name "$cache_name" -delete 2>/dev/null || true
  else
    rm -f "$tmp_file"
    return 1
  fi
}

output_binding_records() {
  local cache_dir cache_file cache_name

  cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/fuzi"
  cache_name="keybindings-$(keybindings_cache_key).records"
  cache_file="$cache_dir/$cache_name"

  if [[ -s $cache_file ]]; then
    cat "$cache_file"
  elif mkdir -p "$cache_dir" 2>/dev/null && refresh_keybindings_cache "$cache_dir" "$cache_file" "$cache_name"; then
    cat "$cache_file"
  else
    output_binding_records_uncached
  fi
}

output_keybindings() {
  output_binding_records | cut -f1
}

dispatch_binding() {
  local dispatcher="$1"
  local arg="$2"

  case "$dispatcher" in
  spawn|exec)
    if [[ -n $arg ]]; then
      mmsg dispatch "spawn,$arg" 2>/dev/null || (nohup bash -c "$arg" >/dev/null 2>&1 &)
    fi
    ;;
  "") return 1 ;;
  *)
    if [[ -n $arg ]]; then
      mmsg dispatch "$dispatcher,$arg"
    else
      mmsg dispatch "$dispatcher"
    fi
    ;;
  esac
}

if [[ $1 == "--print" || $1 == "-p" ]]; then
  output_keybindings
else
  records=$(output_binding_records)
  selection=$(cut -f1 <<<"$records" |
    fuzi-menu-select 'Search' -- --width 800 --height 500)

  if [[ -n $selection ]]; then
    record=$(awk -F '\t' -v selection="$selection" '$1 == selection { print; exit }' <<<"$records")
    dispatcher=$(cut -f2 <<<"$record")
    arg=$(cut -f3- <<<"$record")

    dispatch_binding "$dispatcher" "$arg"
  fi
fi
